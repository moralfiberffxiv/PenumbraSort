<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>PenumbraSort</AssemblyName>
    <RootNamespace>PenumbraSort</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    
    <!-- Package Metadata -->
    <PackageId>moralfiberffxiv.PenumbraSort</PackageId>
    <Version>1.0.0</Version>
    <Authors>moralfiberffxiv</Authors>
    <Description>Sort and tag your Penumbra mods by clothing type, season, and occasion. A Dalamud plugin for FFXIV.</Description>
    <RepositoryUrl>https://github.com/moralfiberffxiv/PenumbraSort</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/moralfiberffxiv/PenumbraSort</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Explicit output path so the workflow can find the DLL reliably -->
    <OutputPath>bin\x64\$(Configuration)\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Dalamud library path — works both locally (AppData) and in CI (Actions runner) -->
    <DalamudLibPath Condition="'$(GITHUB_ACTIONS)' == 'true'">$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(GITHUB_ACTIONS)' != 'true'">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <!-- ── Dalamud References / CI package restore ───────────────────────────────────────────── -->
  <ItemGroup>
    <Reference Include="Dalamud" Condition="'$(GITHUB_ACTIONS)' != 'true'">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Dalamud" Version="14.0.3" Condition="'$(GITHUB_ACTIONS)' == 'true'" />
  </ItemGroup>

  <!-- ── NuGet Dependencies ─────────────────────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.87.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
