<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>

    <!-- Plugin manifest — generated into PenumbraSort.json by DalamudPackager -->
    <Name>PenumbraSort</Name>
    <Author>moralfiberffxiv</Author>
    <Punchline>Organize your Penumbra mods by outfit type, season, and occasion.</Punchline>
    <Description>Sort and tag your Penumbra mods by clothing type, season, and occasion. Keep your glamour collection perfectly organized. Use /penumbrasort to open.</Description>
    <RepoUrl>https://github.com/moralfiberffxiv/PenumbraSort</RepoUrl>
    <Tags>penumbra;mods;glamour;organization;fashion;sorting</Tags>
  </PropertyGroup>

  <!-- Let DalamudPackager create latest.zip but exclude deps.json and runtimeconfig -->
  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <DalamudPackager
      ProjectDir="$(ProjectDir)"
      OutputPath="$(OutputPath)"
      AssemblyName="$(AssemblyName)"
      MakeZip="true"
      Exclude="$(AssemblyName).deps.json;$(AssemblyName).runtimeconfig.json" />
  </Target>

</Project>
